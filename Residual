############################################################
## Randomized Quantile Residual Analysis for BDME Regression
############################################################

set.seed(2026)
## ---------------- Required Packages ----------------
library(Ecdat)
library(MASS)
library(COUNT)
library(car)

# Load data
data("Bids")
df <- Bids
y <- df$numbids
final_formula <-numbids ~ weeks  + bidprem + insthold + size + leglrest + rearest + finrest + regulatn + whtknght

## ---------------- Design Matrix ----------------
X <- model.matrix(final_formula, data = df)


nb_model <- glm.nb(final_formula, data = df)

init_beta <- coef(nb_model)


# ---------------- BDME Model ----------------
ll_bdme <- function(beta, data) {
  X <- model.matrix(final_formula, data = data)
  eta <- X %*% beta
  mu <- exp(eta)
  A <- sqrt(mu^2 + 6 * mu + 1)
  ll <- sum(
    2 * log((3 + mu - A) / 2) +
      (2 * y - 1) * log((A - mu - 1) / 2) +
      log(y + ((A - mu - 1) * (3 + mu - A)) / 4) -
      (y + 2) * log(1 - ((A - mu - 1) * (3 + mu - A)) / 4)
  )
  return(-ll)
}
fit_bdme <- optim(init_beta, ll_bdme, data = df, method = "Nelder-Mead", hessian = TRUE)
beta_bdme <- fit_bdme$par
log_like_bdme <- -ll_bdme(beta_bdme, df)

## ---------------- Fitted BDME Parameters ----------------
# beta_bdme is assumed to be already estimated via optim()
# from your BDME likelihood code

eta_hat <- as.vector(X %*% beta_bdme)
mu_hat  <- exp(eta_hat)

n <- length(y)

## ---------------- Mean-based Reparameterization ----------------
p_mu <- function(mu) {
  (sqrt(mu^2 + 6 * mu + 1) - (mu + 1)) / 2
}

## ---------------- BDME CDF ----------------
bdme_cdf <- function(x, mu) {
  p <- p_mu(mu)
  
  num <- p^(2 * x + 1) * (1 + (1 - p) * (x - p^2))
  den <- (1 - p * (1 - p))^(x + 2)
  
  1 - num / den
}

## ---------------- Randomized Quantile Residuals ----------------
set.seed(2025)

u<-numeric(n)
a<- numeric(n)
b<- numeric(n)

for (i in seq_len(n)) {
  a[i] <- ifelse(y[i] == 0, 0, bdme_cdf(y[i]-1, mu_hat[i]))
  b[i] <- bdme_cdf(y[i], mu_hat[i])
  
  u[i] <- runif(1, min = a[i], max = b[i])
}

rq <- qnorm(u)

## ---------------- Diagnostic Plots ----------------


library(ggplot2)
library(qqplotr)
library(patchwork)

# Common theme for symmetry
common_theme <- theme_classic(base_size = 12) +
  theme(
    panel.grid = element_blank(),
    panel.border = element_rect(
      colour = "black",
      fill = NA,
      linewidth = 0.8
    ),
    axis.title = element_text(size = 14, face = "bold"),
    axis.text  = element_text(size = 12, face = "bold"),
    plot.margin = margin(10, 10, 10, 10)
  )

## ---------------- Residuals vs Index ----------------
## ---------------- Residuals vs Fitted ----------------
res_df <- data.frame(
  fitted = mu_hat,
  rq     = rq
)

p_res <- ggplot(res_df, aes(x = fitted, y = rq)) +
  geom_point(shape = 16, size = 1.2, color = "red") +
  geom_hline(yintercept = 0, linewidth = 1) +
  geom_hline(yintercept = c(-3, 3),
             linetype = "dashed",
             linewidth = 0.6) +
  coord_cartesian(ylim = c(-3, 3), expand = FALSE) +
  labs(x = "Fitted Values",
       y = expression(r[i])) +
  common_theme

## ---------------- QQ Plot ----------------
pp <- ggplot(data.frame(resid = rq), aes(sample = resid)) +
  stat_qq_band(conf = 0.95, fill = "lightgreen") +
  stat_qq_point(shape = 16, size = 1.2, color = "red") +
  stat_qq_line(linewidth = 1) +
  coord_cartesian(
    xlim = c(-1.8, 2),
    expand = FALSE
  ) +
  labs(x = "Normal Quantiles",
       y = expression(r[i])) +
  common_theme



## ---------------- Arrange Side-by-Side ----------------
p_res + pp + plot_layout(ncol = 2)

## ---------------- Normality Test ----------------
shapiro.test(rq)

